---
import Layout from '../layouts/Layout.astro';
import HeaderNew from '../components/HeaderNew';
import FooterNew from '../components/FooterNew';

const sections = [
  {
    num: "01",
    title: "Introduction",
    intro: "HomeGuru (I) Private Limited (\"HomeGuru\", \"we\", \"our\", or \"us\") operates an online platform that connects students (learners) with independent tutors (service providers) for educational services.",
    items: [],
    outro: "This Privacy Policy explains how we collect, use, store, and protect your information when you use our platform, website, or services. By accessing or using HomeGuru, you agree to the terms outlined in this policy."
  },
  {
    num: "02",
    title: "Information We Collect",
    intro: "To provide a seamless and effective experience, we collect certain types of information from users:",
    items: [
      "Personal information such as your name, phone number, email address, and location details",
      "Usage-related data such as device information, IP address, browsing activity, and interaction with the platform",
      "Communication data including chat interactions and call-related metadata (not recordings unless explicitly stated)",
      "Payment-related information such as transaction details",
      "Class-related data including session bookings, tutor interactions, and feedback provided"
    ],
    outro: ""
  },
  {
    num: "03",
    title: "How We Use Your Information",
    intro: "The information collected is primarily used to ensure smooth functioning of the platform and to deliver a high-quality learning experience. We use your data to:",
    items: [
      "Match students with suitable tutors",
      "Facilitate communication between users",
      "Manage and schedule classes",
      "Process payments securely",
      "Improve our platform based on user behavior and feedback",
      "Maintain platform safety, prevent fraud, and ensure compliance with legal obligations"
    ],
    outro: ""
  },
  {
    num: "04",
    title: "Sharing of Information",
    intro: "HomeGuru does not sell your personal data to third parties.",
    items: [
      "We may share relevant information between students and tutors to enable classes and communication",
      "We may share data with trusted third-party partners such as payment gateways, technology service providers, and analytics tools",
      "We may be required to disclose information to legal authorities or government bodies in compliance with applicable laws"
    ],
    outro: ""
  },
  {
    num: "05",
    title: "International Data Transfers",
    intro: "As part of operating a global platform, your information may be processed and stored in locations outside your country of residence.",
    items: [],
    outro: "By using HomeGuru, you consent to the transfer, storage, and processing of your data in such jurisdictions, subject to applicable data protection standards."
  },
  {
    num: "06",
    title: "Data Security",
    intro: "We implement industry-standard security measures to protect your personal information from unauthorized access, misuse, or disclosure.",
    items: [],
    outro: "While we strive to ensure the highest level of data protection, no system can be completely secure. Therefore, we cannot guarantee absolute security of your data."
  },
  {
    num: "07",
    title: "Data Retention",
    intro: "We retain your information only for as long as necessary to provide our services, fulfill legal obligations, resolve disputes, and enforce our agreements.",
    items: [],
    outro: "Once the data is no longer required, we take reasonable steps to securely delete or anonymize it."
  },
  {
    num: "08",
    title: "Your Rights",
    intro: "As a user, you have the right to access, update, or request deletion of your personal data.",
    items: [],
    outro: "If you wish to exercise these rights, you may contact us through the details provided below. We will take reasonable steps to process your request in accordance with applicable laws."
  },
  {
    num: "09",
    title: "Cookies and Tracking",
    intro: "HomeGuru uses cookies and similar technologies to enhance user experience, analyze platform usage, and improve our services.",
    items: [],
    outro: "By continuing to use the platform, you consent to the use of these technologies."
  },
  {
    num: "10",
    title: "Children's Privacy",
    intro: "HomeGuru services may be used by students under the supervision of parents or guardians.",
    items: [],
    outro: "We do not knowingly collect personal data from children without appropriate supervision or consent."
  },
  {
    num: "11",
    title: "Platform Role",
    intro: "HomeGuru acts as a technology platform that connects students with independent tutors.",
    items: [],
    outro: "Tutors are not employees of HomeGuru, and we do not take responsibility for the conduct, teaching methods, or outcomes of individual tutors. Our role is limited to facilitating the connection and enabling the learning experience."
  },
  {
    num: "12",
    title: "Governing Law",
    intro: "This Privacy Policy shall be governed by and interpreted in accordance with the laws of India.",
    items: [],
    outro: ""
  },
  {
    num: "13",
    title: "Contact Information",
    intro: "For any queries or concerns, reach us at:",
    items: [
      "Email: support@homeguruworld.com",
      "Phone: +91 90019 90019",
      "Website: www.homeguruworld.com"
    ],
    outro: ""
  },
  {
    num: "14",
    title: "Consent",
    intro: "By using the HomeGuru platform, you acknowledge that you have read, understood, and agreed to this Privacy Policy.",
    items: [],
    outro: ""
  },
];
---

<Layout title="Privacy Policy | HomeGuru">
  <HeaderNew client:load />

  <main style="font-family: Matter, sans-serif; background: #fff;">

    {/* ── Hero ── */}
    <section style="padding-top: 140px; padding-bottom: 72px; border-bottom: 1px solid #F0F0F0;">
      <div style="max-width: 680px; margin: 0 auto; padding: 0 24px;">
        <p style="font-size: 12px; font-weight: 600; letter-spacing: 2.5px; text-transform: uppercase; color: #999; margin-bottom: 20px;">
          Legal · HomeGuru (I) Private Limited
        </p>
        <h1 class="font-season-mix" style="font-size: clamp(40px, 6vw, 64px); line-height: 1.04; letter-spacing: -1.5px; color: #111; margin: 0 0 24px 0;">
          Privacy<br/>Policy
        </h1>
        <p style="font-size: 17px; line-height: 1.75; color: #666; max-width: 520px; margin: 0 0 28px 0;">
          This policy explains how we collect, use, store, and protect your information when you use the HomeGuru platform.
        </p>
        <div style="display: flex; align-items: center; gap: 16px;">
          <span style="font-size: 12px; color: #999;">Effective Date: 1st April 2026</span>
          <span style="width: 3px; height: 3px; border-radius: 50%; background: #D0D0D0; display: inline-block;"></span>
          <span style="font-size: 12px; color: #999;">14 Sections</span>
        </div>
      </div>
    </section>

    {/* ── Content ── */}
    <section style="max-width: 680px; margin: 0 auto; padding: 0 24px 120px 24px;">

      {sections.map((section, i) => (
        <div style={`padding: 52px 0; ${i < sections.length - 1 ? 'border-bottom: 1px solid #F2F2F2;' : ''}`}>

          <div style="display: flex; align-items: baseline; gap: 14px; margin-bottom: 20px;">
            <span style="font-size: 11px; font-weight: 600; letter-spacing: 1.5px; color: #C0C0C0; text-transform: uppercase; flex-shrink: 0;">
              {section.num}
            </span>
            <h2 class="font-season-mix" style="font-size: 22px; color: #111; line-height: 1.2; letter-spacing: -0.3px; margin: 0;">
              {section.title}
            </h2>
          </div>

          <div style="padding-left: 36px;">
            {section.intro && (
              <p style="font-size: 15px; line-height: 1.8; color: #444; margin: 0 0 16px 0;">
                {section.intro}
              </p>
            )}

            {section.items.length > 0 && (
              <ul style="margin: 0 0 16px 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px;">
                {section.items.map((item) => (
                  <li style="display: flex; align-items: flex-start; gap: 12px;">
                    <span style="margin-top: 9px; flex-shrink: 0; width: 4px; height: 4px; border-radius: 50%; background: #C8C8C8; display: inline-block;"></span>
                    <span style="font-size: 15px; line-height: 1.75; color: #444;">{item}</span>
                  </li>
                ))}
              </ul>
            )}

            {section.outro && (
              <p style="font-size: 14px; line-height: 1.75; color: #888; margin: 0; padding-top: 14px; border-top: 1px solid #F0F0F0;">
                {section.outro}
              </p>
            )}
          </div>

        </div>
      ))}

      {/* Acknowledgement */}
      <div style="margin-top: 16px; padding: 32px 36px; background: #F7F7F7; border-radius: 16px;">
        <p style="font-size: 14px; line-height: 1.8; color: #666; margin: 0; text-align: center;">
          By using HomeGuru, you acknowledge that you have read, understood, and agreed to this Privacy Policy.
        </p>
      </div>

      {/* Contact */}
      <div style="margin-top: 16px; padding: 32px 36px; border: 1px solid #EBEBEB; border-radius: 16px; display: flex; flex-direction: column; gap: 6px;">
        <p style="font-size: 13px; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: #999; margin: 0;">
          Questions?
        </p>
        <p class="font-season-mix" style="font-size: 22px; color: #111; margin: 4px 0 8px 0;">Still have questions?</p>
        <p style="font-size: 14px; color: #888; margin: 0 0 20px 0; line-height: 1.7;">
          We're here to help. Reach out and we'll get back to you.
        </p>
        <div style="display: flex; flex-wrap: wrap; gap: 10px;">
          <a
            href="mailto:support@homeguruworld.com"
            style="display: inline-flex; align-items: center; gap: 8px; background: #111; color: #fff; font-size: 13px; font-weight: 600; padding: 11px 22px; border-radius: 100px; text-decoration: none; width: fit-content;"
          >
            support@homeguruworld.com
          </a>
          <a
            href="tel:+919001990019"
            style="display: inline-flex; align-items: center; gap: 8px; background: #F5F5F5; color: #111; font-size: 13px; font-weight: 600; padding: 11px 22px; border-radius: 100px; text-decoration: none; width: fit-content;"
          >
            +91 90019 90019
          </a>
        </div>
      </div>

    </section>
  </main>

  <FooterNew client:load />
</Layout>
