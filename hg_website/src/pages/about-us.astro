---
import Layout from '../layouts/Layout.astro';
import HeaderNew from '../components/HeaderNew';
import FooterNew from '../components/FooterNew';
import { fetchLatestBlogs } from '../lib/fetchBlogs';

const blogs = await fetchLatestBlogs(1);
const latestBlog = blogs[0];
---

<Layout title="About Us | HomeGuru">
  <HeaderNew client:load latestBlogTitle={latestBlog?.title} latestBlogHref={latestBlog?.href} latestBlogImage={latestBlog?.image} />

  <main class="z-100 flex-1 bg-[#fafafa] relative flex flex-col" style="font-family: Matter, sans-serif;">
    <div class="flex flex-col gap-24 md:gap-40 mx-auto w-full overflow-x-clip">

      {/* ── Hero ── */}
      <section class="relative pt-36 md:pt-44 pb-20 md:pb-28 overflow-hidden">
        <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(249,115,22,0.06) 0%, transparent 70%); pointer-events: none;"></div>
        <div class="relative z-10 max-w-[800px] mx-auto px-6 text-center flex flex-col items-center gap-7">
          <span
            class="font-matter text-[11px] font-semibold uppercase tracking-[3px] px-4 py-1.5 rounded-full"
            style="color: #F97316; background: rgba(249,115,22,0.08); border: 1px solid rgba(249,115,22,0.15);"
          >
            About HomeGuru
          </span>
          <h1 class="font-season-mix text-[36px] md:text-[60px] leading-[1.06] tracking-tight text-[#111]">
            Every student deserves<br class="hidden md:block" />
            the <span style="color: #F97316;">right</span> teacher.
          </h1>
          <p class="font-matter text-base md:text-lg max-w-[560px] leading-relaxed text-[#666]">
            For years, that connection has been left to chance. We started HomeGuru to change that.
          </p>
        </div>
      </section>

      {/* ── Our Story ── */}
      <section class="relative mx-auto w-[85%] md:w-9/12 max-w-[1100px]">
        <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-start">
          <div class="flex flex-col gap-5 flex-1">
            <span class="font-matter text-[11px] font-semibold tracking-[4px] uppercase text-gray-400">
              Our Story
            </span>
            <h2 class="font-season-mix text-3xl md:text-[44px] text-black leading-[1.1] tracking-tight">
              Built on three decades<br class="hidden md:block" />
              of <span style="color: #F97316;">experience</span>.
            </h2>
          </div>
          <div class="flex flex-col gap-6 flex-1 md:pt-10">
            <p class="font-matter text-[#555] text-base md:text-lg leading-[1.8]">
              After spending over three decades in education, Vikram Ahuja saw the same pattern repeat. Students trying harder, yet not moving forward. Not because they lacked ability, but because they lacked the right guidance.
            </p>
            <p class="font-matter text-[#555] text-base md:text-lg leading-[1.8]">
              He understood something simple, yet powerful. When the match is right, everything changes. That belief led to the creation of HomeGuru.
            </p>
            <p class="font-matter text-[#888] text-sm leading-[1.8]">
              Now, with his son Vansh Ahuja joining him, the vision has grown stronger and sharper. Bringing together decades of experience and a new-age approach to technology, they are building HomeGuru into a global learning platform designed for how students actually learn.
            </p>
          </div>
        </div>
      </section>

      {/* ── Founders ── */}
      <section class="relative mx-auto w-[85%] md:w-9/12 max-w-[1100px]">
        <div class="flex flex-col items-center gap-10 md:gap-14">
          <div class="flex flex-col items-center text-center gap-4 max-w-2xl">
            <span class="font-matter text-[11px] font-semibold tracking-[4px] uppercase text-gray-400">
              Leadership
            </span>
            <h2 class="font-season-mix text-3xl md:text-[44px] text-black leading-[1.1] tracking-tight">
              Our Founders
            </h2>
            <p class="font-matter text-[#666] text-base md:text-lg leading-relaxed">
              A shared mission. A generational vision. One goal.
            </p>
          </div>

          <div class="w-full overflow-hidden" style="border-radius: 32px; border: 1px solid #E7E7E7; background: #F6F6F6;">
            <div class="relative w-full overflow-hidden" style="max-height: 520px;">
              <img
                src="/assets/founders.jpeg"
                alt="Vikram Ahuja and Vansh Ahuja, founders of HomeGuru"
                class="w-full h-full object-cover"
                style="display: block;"
              />
              <div style="position: absolute; bottom: 0; left: 0; right: 0; height: 55%; background: linear-gradient(to top, rgba(0,0,0,0.65), transparent); pointer-events: none;"></div>

              {/* Left: Vikram Ahuja */}
              <div class="hidden md:block absolute" style="bottom: 30px; left: 44px;">
                <svg width="90" height="64" viewBox="0 0 90 64" fill="none" style="display: block; margin-left: 6px; margin-bottom: -2px;">
                  <path d="M10 58 Q18 36 42 18 Q54 10 64 6" stroke="rgba(255,255,255,0.55)" stroke-width="1" stroke-linecap="round" fill="none" />
                  <circle cx="64" cy="6" r="2.5" fill="rgba(255,255,255,0.55)" />
                </svg>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <div style="width: 5px; height: 5px; border-radius: 50%; background: #F97316; flex-shrink: 0;"></div>
                  <div>
                    <p class="font-season-mix" style="font-size: 16px; color: #fff; text-shadow: 0 1px 10px rgba(0,0,0,0.5); line-height: 1.2;">Vikram Ahuja</p>
                    <p class="font-matter" style="font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 3px;">Founder &middot; 30+ years in Education</p>
                  </div>
                </div>
              </div>

              {/* Right: Vansh Ahuja */}
              <div class="hidden md:block absolute" style="bottom: 30px; right: 44px;">
                <svg width="90" height="64" viewBox="0 0 90 64" fill="none" style="display: block; margin-left: auto; margin-right: 6px; margin-bottom: -2px;">
                  <path d="M80 58 Q72 36 48 18 Q36 10 26 6" stroke="rgba(255,255,255,0.55)" stroke-width="1" stroke-linecap="round" fill="none" />
                  <circle cx="26" cy="6" r="2.5" fill="rgba(255,255,255,0.55)" />
                </svg>
                <div style="display: flex; align-items: center; gap: 8px; justify-content: flex-end;">
                  <div style="text-align: right;">
                    <p class="font-season-mix" style="font-size: 16px; color: #fff; text-shadow: 0 1px 10px rgba(0,0,0,0.5); line-height: 1.2;">Vansh Ahuja</p>
                    <p class="font-matter" style="font-size: 11px; color: rgba(255,255,255,0.5); margin-top: 3px;">Co-Founder &middot; Technology &amp; Product</p>
                  </div>
                  <div style="width: 5px; height: 5px; border-radius: 50%; background: #F97316; flex-shrink: 0;"></div>
                </div>
              </div>
            </div>
            {/* Mobile founder labels */}
            <div class="flex md:hidden justify-between px-6 py-5" style="border-top: 1px solid #EBEBEB;">
              <div>
                <p class="font-season-mix text-[#111] text-sm">Vikram Ahuja</p>
                <p class="font-matter text-[#888] text-xs" style="margin-top: 2px;">Founder</p>
              </div>
              <div style="text-align: right;">
                <p class="font-season-mix text-[#111] text-sm">Vansh Ahuja</p>
                <p class="font-matter text-[#888] text-xs" style="margin-top: 2px;">Co-Founder</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* ── What We Do ── */}
      <section class="relative mx-auto w-[85%] md:w-9/12 max-w-[1100px]">
        <div class="flex flex-col items-center text-center gap-4 mb-12 md:mb-16 max-w-2xl mx-auto">
          <span class="font-matter text-[11px] font-semibold tracking-[4px] uppercase text-gray-400">
            What We Do
          </span>
          <h2 class="font-season-mix text-3xl md:text-[44px] text-black leading-[1.1] tracking-tight">
            Learning that's <span style="color: #F97316;">personal</span>,<br class="hidden md:block" />
            not one-size-fits-all.
          </h2>
          <p class="font-matter text-[#666] text-base md:text-lg leading-relaxed">
            HomeGuru connects students with tutors who are right for them, not just available. Through one-on-one learning, we create experiences that are personal, focused, and built around the student.
          </p>
        </div>

        <div class="flex flex-row gap-4 overflow-x-auto" style="-webkit-overflow-scrolling: touch; scrollbar-width: none;">
          {[
            { num: "01", title: "Right Match, Not Random Match", desc: "Every student is paired with a tutor who fits their learning style and needs.", icon: "M13 10V3L4 14h7v7l9-11h-7z" },
            { num: "02", title: "One-on-One Learning", desc: "Focused attention that helps students truly understand, not just memorise.", icon: "M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" },
            { num: "03", title: "Global Access", desc: "Learn from quality tutors across different regions, without limitations.", icon: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9" },
            { num: "04", title: "Beyond Academics", desc: "From school subjects to real-world skills, everything in one place.", icon: "M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" },
          ].map((item, i) => (
            <div
              class="group flex flex-col gap-5 p-6 md:p-7 rounded-[24px] shrink-0 flex-1 transition-all duration-200 hover:bg-white"
              style={`background: #F8F9FA; border: 1px solid #EBEBEB; min-width: 220px;`}
            >
              <div class="flex items-center justify-center shrink-0 w-9 h-9 rounded-xl transition-transform duration-300 group-hover:scale-105" style="background: rgba(249,115,22,0.08); border: 1px solid rgba(249,115,22,0.12);">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none">
                  <path d={item.icon} stroke="#F97316" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </div>
              <div class="flex flex-col gap-1.5">
                <h3 class="font-season-mix text-[16px] md:text-[17px] text-[#111] leading-[1.25]">{item.title}</h3>
                <p class="font-matter text-[13px] text-[#888] leading-[1.6]">{item.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <p class="font-matter text-[#888] text-sm leading-[1.8] text-center mt-8 max-w-lg mx-auto">
          Across academics, languages, and skills, HomeGuru makes learning more effective, more human, and more meaningful.
        </p>
      </section>

      {/* ── Our Vision ── */}
      <section class="relative mx-auto w-[85%] md:w-9/12 max-w-[1100px]">
        <div
          class="w-full overflow-hidden relative"
          style="border-radius: 32px; background: #FAFAFA; border: 1px solid #EBEBEB;"
        >
          <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 70% 65% at 50% 110%, rgba(249,115,22,0.12) 0%, rgba(249,115,22,0.04) 25%, transparent 60%); pointer-events: none;"></div>
          <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 50% 55% at 20% 100%, rgba(10,33,86,0.08) 0%, transparent 55%); pointer-events: none;"></div>

          <svg width="100%" height="100%" style="position: absolute; inset: 0; opacity: 0.35; pointer-events: none;">
            <defs>
              <pattern id="vision-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M40 0H0V40" fill="none" stroke="#E5E7EB" stroke-width="0.5" />
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#vision-grid)" />
          </svg>

          <div class="relative flex flex-col items-center justify-center gap-7 px-8 py-20 md:py-28 text-center z-10">
            <span
              class="font-matter text-[11px] font-semibold uppercase tracking-[3px] px-4 py-1.5 rounded-full"
              style="color: #0A2156; background: rgba(10,33,86,0.06); border: 1px solid rgba(10,33,86,0.1);"
            >
              Our Vision
            </span>
            <h2 class="font-season-mix text-[28px] md:text-[44px] leading-[1.1] tracking-tight max-w-xl text-[#111]">
              A world where no student<br class="hidden md:block" /> feels <span style="color: #F97316;">lost</span>.
            </h2>
            <p class="font-matter text-base md:text-lg max-w-lg leading-relaxed text-[#666]">
              Where learning is not standardised, but personalised. Where finding the right teacher is not difficult, it's natural.
            </p>

            <div class="flex flex-col md:flex-row gap-4 md:gap-0 mt-4 w-full max-w-lg">
              {[
                "Every student has access to the right mentor",
                "Every tutor has access to the right opportunities",
                "Learning becomes personal, flexible, and limitless",
              ].map((item, i) => (
                <div class="flex flex-col gap-1 flex-1 md:px-5" style={i < 2 ? "border-right: 1px solid #E5E7EB;" : ""}>
                  <span class="font-matter text-[13px] text-[#444] leading-[1.6] text-center">{item}</span>
                </div>
              ))}
            </div>

            <p class="font-matter text-sm text-[#999] max-w-md leading-[1.7] mt-2">
              Because when the foundation is right, everything that follows becomes stronger. When a student meets the right mentor, it doesn't just improve learning, it transforms it.
            </p>
          </div>
        </div>
      </section>

      {/* ── CTA ── */}
      <section class="relative mx-auto mb-16 md:mb-24 w-[85%] md:w-9/12 max-w-[1100px]">
        <div
          class="w-full overflow-hidden relative"
          style="border-radius: 32px; background: #FAFAFA; border: 1px solid #EBEBEB;"
        >
          {/* Soft light mesh gradient — same as landing page */}
          <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 70% 65% at 50% 110%, rgba(249,115,22,0.18) 0%, rgba(249,115,22,0.08) 25%, transparent 60%); pointer-events: none;"></div>
          <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 50% 55% at 20% 100%, rgba(139,92,246,0.14) 0%, transparent 55%); pointer-events: none;"></div>
          <div style="position: absolute; inset: 0; background: radial-gradient(ellipse 50% 55% at 80% 100%, rgba(59,130,246,0.10) 0%, transparent 55%); pointer-events: none;"></div>

          <svg width="100%" height="100%" style="position: absolute; inset: 0; opacity: 0.4; pointer-events: none;">
            <defs>
              <pattern id="cta-grid-about" width="40" height="40" patternUnits="userSpaceOnUse">
                <path d="M40 0H0V40" fill="none" stroke="#E5E7EB" stroke-width="0.5" />
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#cta-grid-about)" />
          </svg>

          <div class="relative flex flex-col items-center justify-center gap-7 px-8 py-20 md:py-28 text-center z-10">
            <span
              class="font-matter text-[11px] font-semibold uppercase tracking-[3px] px-4 py-1.5 rounded-full"
              style="color: #F97316; background: rgba(249,115,22,0.08); border: 1px solid rgba(249,115,22,0.15);"
            >
              Start Today
            </span>
            <h2 class="font-season-mix text-[32px] md:text-[52px] leading-[1.1] tracking-tight max-w-xl text-[#111]">
              Find your Guru.
            </h2>
            <p class="font-matter text-base md:text-lg max-w-md leading-relaxed text-[#666]">
              The right guidance is closer than you think. Join thousands of students learning with the right tutor.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 mt-4">
              <a href="/find-tutor">
                <button
                  class="inline-flex items-center justify-center gap-2 font-matter font-semibold rounded-full px-8 py-4 text-base text-white transition-all duration-200 hover:opacity-90 active:scale-95"
                  style="background: #F97316;"
                >
                  Find Your Tutor
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M2.5 8H13.5M13.5 8L8 2.5M13.5 8L8 13.5" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
              </a>
              <a href="/become-a-tutor">
                <button
                  class="inline-flex items-center justify-center font-matter font-semibold rounded-full px-8 py-4 text-base transition-all duration-200 active:scale-95"
                  style="color: #111; border: 1px solid #E5E7EB; background: #fff;"
                >
                  Become a Tutor
                </button>
              </a>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>

  <FooterNew client:load />
</Layout>
